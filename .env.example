# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key for question parsing. Without it, every question is answered by the keyword parser.
ANTHROPIC_API_KEY=

# Admin login for /admin, stored as a hash: run `npm run hash-password` and paste the whole <salt>:<hash> value.
ADMIN_PASSWORD_HASH=

# Optional: a different Claude model for parsing (default: claude-haiku-5-5).
# LLM_MODEL=
